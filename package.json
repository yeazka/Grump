{
  "name": "grump",
  "version": "1.0.9",
  "description": "Grump - Sleek Desktop Dynamic Island with Personality",
  "main": "main.js",
  "author": "Grump Team",
  "repository": {
    "type": "git",
    "url": "https://github.com/yeazka/Grump.git"
  },
  "scripts": {
    "start": "electron .",
    "dist": "node tools/release.cjs unpacked",
    "build:setup": "node tools/release.cjs setup",
    "build:setup:signed": "node tools/release.cjs setup --signed",
    "build:portable": "node tools/release.cjs portable",
    "build:steam": "node tools/release.cjs steam",
    "build:store": "node tools/release.cjs store",
    "build:all": "node tools/release.cjs all",
    "audit:package": "node tools/audit-package.cjs",
    "audit:git": "node tools/audit-git.cjs",
    "export:github": "node tools/export-github.cjs",
    "test": "node --test tests/*.test.cjs"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "tesseractjs": "npm:tesseract.js@^7.0.0"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.grump.island",
    "productName": "Grump",
    "asarUnpack": [
      "media.ps1",
      "connectivity.ps1"
    ],
    "files": [
      "main.js",
      "preload.js",
      "runtime-policy.cjs",
      "ipc-security.cjs",
      "json-store.cjs",
      "activity-worker.cjs",
      "activity-monitor.cjs",
      "productivity.cjs",
      "personal-features.cjs",
      "codex-activity.cjs",
      "antigravity-activity.cjs",
      "weather.cjs",
      "productivity-preload.cjs",
      "capture-preload.cjs",
      "media.ps1",
      "renderer/**/*",
      "assets/**/*",
      "package.json",
      "!**/.env{,.*}",
      "!**/.dev.vars{,.*}",
      "!**/*.{pem,key,cert,cer,pfx,p12,log,map}",
      "!**/{.npmrc,.yarnrc,credentials*.json,service-account*.json,secrets*.json}",
      "!**/{settings.json,timer.json,productivity.json,personal-features.json,*.json.bak,*.json.tmp,startup.log}",
      "!**/{backup-*,scratch,.git,.21st,userData,Local Storage,Session Storage}/**/*",
      "!renderer/fonts/SFPro*.ttf",
      "connectivity.ps1"
    ],
    "afterPack": "./tools/audit-package.cjs",
    "publish": {
      "provider": "github",
      "owner": "yeazka",
      "repo": "Grump"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Grump",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    },
    "appx": {
      "applicationId": "GrumpNotch",
      "identityName": "Azka.GrumpNotch",
      "publisher": "CN=980B68A8-B7B5-43D1-AEB5-4A2CA3EDBEE8",
      "publisherDisplayName": "Azka",
      "displayName": "Grump Notch",
      "backgroundColor": "#000000",
      "artifactName": "GrumpNotch-${version}.${ext}"
    }
  }
}
